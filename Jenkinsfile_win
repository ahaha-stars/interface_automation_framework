pipeline {
    agent any

    environment {
        // Windows 通常直接叫 python
        PYTHON_PATH = "python"
        ALLURE_RESULTS = "report/temp"
    }

    stages {
        stage('环境检查与准备') {
            steps {
                echo '检查 Python 环境...'
                bat "${PYTHON_PATH} --version"

                echo '清空临时数据文件 extract.yaml...'
                bat "${PYTHON_PATH} -c \"open('extract.yaml', 'w').close()\""

                echo '正在当前 Workspace 创建 Python 虚拟环境...'
                bat "${PYTHON_PATH} -m venv venv"
            }
        }

        stage('安装依赖') {
            steps {
                echo '在虚拟环境中安装项目依赖...'
                bat "venv\\Scripts\\python -m pip install -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple"
            }
        }

        stage('执行接口测试') {
            steps {
                echo '使用虚拟环境的 Pytest 执行测试用例...'
                bat "venv\\Scripts\\pytest --alluredir=${ALLURE_RESULTS} --clean-alluredir"
            }
        }

        stage('生成测试报告') {
            steps {
                echo '通过 Allure 生成可视化 HTML 报告...'
                script {
                    allure includeProperties: false, jdk: '', results: [[path: "${ALLURE_RESULTS}"]]
                }
            }
        }
    }

    post {
        always {
            echo '归档测试日志...'
            archiveArtifacts artifacts: 'logs/*.log', allowEmptyArchive: true
        }

        failure {
            echo '测试失败，触发钉钉通知...'
            // 【关键修复】使用虚拟环境的 python 运行钉钉脚本，确保能找到 requests 等依赖包
            bat "venv\\Scripts\\python common/dingRobot.py"
        }
    }
}