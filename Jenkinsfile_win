pipeline {
    agent any

    environment {
        // 如果 python 已加入系统变量，使用 "python" 即可
        PYTHON_PATH = "python"
        ALLURE_RESULTS = "report/temp"
    }

    // 设置全局超时，防止 Windows 进程挂起导致资源浪费
    options {
        timeout(time: 10, unit: 'MINUTES')
    }

    stages {
        stage('环境检查与准备') {
            steps {
                echo '检查 Python 环境...'
                powershell "${PYTHON_PATH} --version"

                echo '初始化临时数据文件 extract.yaml...'
                // 使用 PowerShell 原生命令清空或创建文件，避免 Python 引号冲突
                powershell "if (Test-Path 'extract.yaml') { Remove-Item 'extract.yaml' }; New-Item -Path 'extract.yaml' -ItemType File"

                echo '正在当前 Workspace 创建 Python 虚拟环境...'
                powershell "${PYTHON_PATH} -m venv venv"
            }
        }

        stage('安装依赖') {
            steps {
                echo '在虚拟环境中安装项目依赖...'
                // 使用 ./ 指定当前目录下的路径，PowerShell 对正斜杠支持更好
                powershell "./venv/Scripts/python -m pip install --upgrade pip"
                powershell "./venv/Scripts/python -m pip install -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple"
            }
        }

        stage('执行接口测试') {
            steps {
                echo '使用虚拟环境的 Pytest 执行测试用例...'
                // 给路径加单引号，防止路径中可能出现的空格或特殊字符
                powershell "./venv/Scripts/pytest --alluredir='${ALLURE_RESULTS}' --clean-alluredir"
            }
        }

        stage('生成测试报告') {
            steps {
                echo '通过 Allure 生成可视化 HTML 报告...'
                script {
                    // 这是 Jenkins 插件步骤，保持原样
                    allure includeProperties: false, jdk: '', results: [[path: "${ALLURE_RESULTS}"]]
                }
            }
        }
    }

    post {
        always {
            echo '归档测试日志...'
            // 修复了之前导致报错的引用标记问题
            archiveArtifacts artifacts: 'logs/*.log', allowEmptyArchive: true
        }

        failure {
            echo '测试失败，触发钉钉通知...'
            // 使用虚拟环境运行钉钉脚本，确保依赖包可用
            powershell "./venv/Scripts/python common/dingRobot.py"
        }
    }
}